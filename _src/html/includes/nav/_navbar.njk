{% from "html/includes/ui/_dropdown.njk" import dropdown %}
{% macro navbar(props) %}
	<nav class="navbar bg-white qela-navbar">

		{# --- ЛЕВАЯ ЧАСТЬ (Логотип или стрелка назад) --- #}
		{% if props.type == 'logo' %}
			<a class="navbar-brand start-0 p-0 ms-3" href="#"><img src="img/logo-strichka.svg"></a>
		{% elif props.type in['btns', 'btnLeft', 'dropdown'] %}
			<button type="button" class="btn ic-chevron-left start-0 ms-3"></button>
		{% endif %}

		{# --- ЦЕНТРАЛЬНАЯ ЧАСТЬ (Заголовок) --- #}
		<span class="fw-bold text-center qela-clamp" style="--clamp-line: 2">
			{{ props.title | default('Заголовок') }}
		</span>

		{# --- ПРАВАЯ ЧАСТЬ (Кнопки или Дропдаун) --- #}
		{% if props.type == 'dropdown' %}
			{{ dropdown({
            class: 'end-0 me-3',
            btnClass: 'ic-dots',
            item: [
                { ic: 'ic-mute', text: 'Unmute' },
                { ic: 'ic-archive', text: 'Unarchive', class: 'danger' }
            ]
        }) }}
		{% elif props.type in['logo', 'btns', 'btnRight'] %}
			{% if props.btnLink %}
				<a href="#" class="btn btn-link btn-sm text-secondary end-0 me-3">Cancel</a>
			{% else %}
				<button type="button" class="btn ic-order-list me-3 end-0"></button>
			{% endif %}
		{% endif %}

	</nav>
{% endmacro %}